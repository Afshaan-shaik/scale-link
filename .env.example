# ── Server ──────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8080
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=scalelink
POSTGRES_PASSWORD=scalelink_secret
POSTGRES_DB=scalelink
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3

# ── Cache TTLs ────────────────────────────────────────────────────────────────
CACHE_LINK_TTL=1h
CACHE_NEGATIVE_TTL=5m

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CREATE_PER_MIN=20
RATE_LIMIT_REDIRECT_PER_MIN=200
RATE_LIMIT_API_KEY_CREATE_PER_MIN=60

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Short Codes ───────────────────────────────────────────────────────────────
SHORT_CODE_LENGTH=6
REDIRECT_STATUS_CODE=302

# ── Redis Streams (Phase 3) ───────────────────────────────────────────────────
STREAM_CLICK_EVENTS=clicks:events
STREAM_DEAD_LETTER=clicks:dead_letter
CONSUMER_GROUP=click_workers
WORKER_BATCH_SIZE=100
WORKER_BLOCK_MS=2000
WORKER_MAX_RETRIES=3

# ── Observability & Monitoring (Phase 5) ─────────────────────────────────────
METRICS_ENABLED=true
LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_USER_EMAIL=demo@scalelink.dev
SEED_USER_PASSWORD=Demo1234!

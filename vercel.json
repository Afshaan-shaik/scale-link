{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "runtime": "go",
      "entrypoint": "cmd/api/main.go"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/metrics",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(favicon\\.ico|manifest\\.json|logo\\.svg|robots\\.txt)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/:code",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
